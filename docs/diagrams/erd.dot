digraph E {
  rankdir=TB; nodesep=0.35; ranksep=0.45; fontname="Helvetica"; node [fontname="Helvetica", fontsize=10, shape=plaintext]; edge [color="#5c6b68", arrowhead=crow, arrowtail=none, dir=both];
  organizations [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e6f0ee"><b>organizations</b></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">name</td></tr></table>>];
  users [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e6f0ee"><b>users</b></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">email, full_name, password_hash</td></tr><tr><td align="left">role</td></tr><tr><td align="left">iin_hmac (no plaintext IIN)</td></tr><tr><td align="left">phone_enc</td></tr><tr><td align="left">researcher_id, level, points</td></tr><tr><td align="left">organization_id FK</td></tr></table>>];
  programs [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e6f0ee"><b>programs</b></td></tr><tr><td align="left">id PK, organization_id FK</td></tr><tr><td align="left">asset_type, asset_criticality</td></tr><tr><td align="left">in_scope[], out_of_scope[]</td></tr><tr><td align="left">allowed/forbidden_methods[]</td></tr><tr><td align="left">reward_matrix JSONB</td></tr><tr><td align="left">rules_version, starts_at, ends_at</td></tr></table>>];
  safe_harbor [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e6f0ee"><b>safe_harbor_acceptances</b></td></tr><tr><td align="left">user_id FK, program_id FK</td></tr><tr><td align="left">rules_version, accepted_at</td></tr></table>>];
  reports [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e6f0ee"><b>reports</b></td></tr><tr><td align="left">id PK, public_id</td></tr><tr><td align="left">program_id FK, researcher_id FK</td></tr><tr><td align="left">vuln_type, status</td></tr><tr><td align="left">title/target/description/steps/impact/poc _enc</td></tr><tr><td align="left">target_fingerprint (HMAC)</td></tr><tr><td align="left">cvss_vector, cvss_score</td></tr><tr><td align="left">duplicate_of FK, auto_checks JSONB</td></tr></table>>];
  transitions [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e6f0ee"><b>report_transitions</b></td></tr><tr><td align="left">report_id FK, actor_id FK</td></tr><tr><td align="left">from_status, to_status, comment, at</td></tr></table>>];
  assessments [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e6f0ee"><b>assessments</b></td></tr><tr><td align="left">report_id FK (1:1), assessor_id FK</td></tr><tr><td align="left">cvss, real_impact, exploitability, scale</td></tr><tr><td align="left">report_quality, multifactor_score</td></tr><tr><td align="left">baseline_tier/reward, multifactor_tier</td></tr><tr><td align="left">final_tier, override_reason, recommended_reward</td></tr><tr><td align="left">approved_by FK, approved_at, paid_at</td></tr></table>>];
  remediations [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e6f0ee"><b>remediations</b></td></tr><tr><td align="left">report_id FK (1:1)</td></tr><tr><td align="left">responsible, deadline</td></tr><tr><td align="left">fix_note, fixed_at, retest_result</td></tr></table>>];
  audit [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#f6e6dd"><b>audit_log</b> (append-only)</td></tr><tr><td align="left">id, at, actor_id, actor_role</td></tr><tr><td align="left">action, entity, entity_id, details</td></tr><tr><td align="left">prev_hash, hash (SHA-256 chain)</td></tr></table>>];
  organizations -> users; organizations -> programs; users -> safe_harbor; programs -> safe_harbor;
  programs -> reports; users -> reports; reports -> transitions; reports -> assessments; reports -> remediations;
}
